{
  "name": "environment-memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:client": "vite --host 127.0.0.1 --port 5177 --strictPort",
    "dev:server": "tsx watch src/server/main.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx src/server/main.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run build && npm test && python3 -m unittest discover -s tests && python3 scripts/release-check",
    "mcp:memory": "tsx scripts/memory-mcp.ts",
    "build:demo": "tsx scripts/build-demo.ts",
    "demo": "tsx scripts/mobile-preview.ts",
    "build:phone": "tsx scripts/build-phone.ts",
    "demo:phone": "tsx scripts/phone-camera-server.ts",
    "preinstall": "node scripts/check-node.mjs",
    "predev": "node scripts/check-node.mjs",
    "predev:client": "node scripts/check-node.mjs",
    "predev:server": "node scripts/check-node.mjs",
    "prestart": "node scripts/check-node.mjs",
    "prebuild": "node scripts/check-node.mjs",
    "prebuild:demo": "node scripts/check-node.mjs",
    "prebuild:phone": "node scripts/check-node.mjs",
    "predemo": "node scripts/check-node.mjs",
    "predemo:phone": "node scripts/check-node.mjs",
    "pretest": "node scripts/check-node.mjs",
    "precheck": "node scripts/check-node.mjs",
    "premcp:memory": "node scripts/check-node.mjs"
  },
  "dependencies": {
    "@meta-sam/parser": "0.1.0",
    "@modelcontextprotocol/server": "2.4.0",
    "fastify": "5.12.7",
    "lucide-react": "1.66.0",
    "openai": "7.45.0",
    "pngjs": "7.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "24.19.2",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "description": "A visual, dated memory for where objects are and how you use them."
}
