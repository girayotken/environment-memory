#!/usr/bin/env python3
"""Audit the clean source tree without printing matched secret values."""
from pathlib import Path
import re,sys,subprocess
ROOT=Path(__file__).resolve().parent.parent
SKIP={'.git','node_modules','dist','coverage','__pycache__','.venv'}
BLOCK={'.local','.playwright-cli','.playwright','data','output','fixtures','test-results','playwright-report'}
BINARY={'.png','.jpg','.jpeg','.webp','.gif','.mp4','.webm','.wav','.mp3','.sqlite','.db','.zip','.gz','.pem','.key','.p12'}
def inspect(root, strict=False):
 errors=[];files=[]
 if (root/'.git').exists():
  tracked=subprocess.run(['git','ls-files','-z'],cwd=root,check=True,capture_output=True).stdout.split(b'\0')
  for raw in tracked:
   if not raw:continue
   rel=Path(raw.decode())
   if any(part in SKIP|BLOCK for part in rel.parts) or (rel.name.startswith('.env') and rel.name!='.env.example'):
    errors.append(f'{rel}: private/generated file is tracked')
 def walk(folder):
  for p in sorted(folder.iterdir()):
   rel=p.relative_to(root)
   if p.is_symlink():errors.append(f'{rel}: symlink not allowed');continue
   if p.is_dir():
    if p.name in SKIP or p.name in BLOCK:
     if strict:errors.append(f'{rel}: private/generated directory not allowed')
     continue
    yield from walk(p)
   else:yield p
 patterns=[('API token',re.compile(r'\b(?:sk[-_]|LLM_)[A-Za-z0-9_-]{20,}')),('private key',re.compile(r'-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----')),('machine path',re.compile(r'/(?:Users|Volumes)/[^\s\"\']+')),('embedded image',re.compile(r'data:image/[^;\s]+;base64,[A-Za-z0-9+/=]{128,}')),('personal email',re.compile(r'[\w.+-]+@(?:gmail|hotmail|outlook)\.com',re.I)),('credential URL',re.compile(r'https?://[^/\s:@]+:[^/\s@]+@'))]
 for p in walk(root):
  rel=p.relative_to(root);files.append(str(rel))
  if p.name.startswith('.env') and p.name!='.env.example':errors.append(f'{rel}: environment file forbidden')
  if p.suffix.lower() in BINARY or '.sqlite' in p.name or p.suffix=='.log':errors.append(f'{rel}: media, database or local log forbidden')
  try:s=p.read_text('utf-8')
  except (UnicodeError,OSError):errors.append(f'{rel}: non-text source file');continue
  # This exact negative authentication fixture is deliberately not a real credential.
  scanned=s.replace(''.join(('http:', '//user:', 'secret@localhost')),'http://localhost') if str(rel)=='tests/agent-memory-mcp.test.ts' else s
  for label,pattern in patterns:
   if pattern.search(scanned):errors.append(f'{rel}: {label} detected')
  if p.name=='.env.example':
   for line in s.splitlines():
    if re.match(r'\s*[A-Z_]*(?:API_KEY|TOKEN|SECRET|PASSWORD)\s*=',line) and line.partition('=')[2].strip():errors.append(f'{rel}: populated credential example')
  if p.suffix=='.md':
   for target in re.findall(r'\]\(([^)]+)\)',s):
    target=target.split('#')[0].split('?')[0]
    if not target or '://' in target or target.startswith('mailto:'):continue
    dest=(p.parent/target).resolve()
    if not dest.is_relative_to(root.resolve()) or not dest.exists():errors.append(f'{rel}: broken/external relative link')
 return files,errors
if __name__=='__main__':
 files,errors=inspect(ROOT, strict='--distribution' in sys.argv)
 if errors:print('\n'.join(errors),file=sys.stderr);sys.exit(1)
 print(f'PASS: {len(files)} text source files; no forbidden private artifacts or recognized secret patterns')
