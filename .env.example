# Server-only configuration. All providers remain disabled by default.
MODEL_API_KEY=
ENABLE_META_DEMO=false
ENABLE_ROOM_OBSERVER=false
META_CREDITS_CONFIRMED=false
ENABLE_SCAN_TEXT_AGENT=false
ENABLE_SCAN_DETECTION=false
ENABLE_LIVE_META_API=false
ENABLE_LIVE_VISIT_COMPARISON=false

# Explicit allowance for a NEW live demo session. Set values deliberately.
DEMO_AUTHORIZATION_ID=
DEMO_CAP_USD=
DEMO_REQUEST_LIMIT=
DEMO_FRAME_LIMIT=
# Supported: 2048 or 4096.
DEMO_OUTPUT_TOKENS=4096
ROOM_OBSERVER_PROTOCOL=compare-encode-v6

# Optional local speech bridge. No models are bundled or auto-downloaded.
LOCAL_VOICE_PYTHON=
LOCAL_VOICE_MODEL=
LOCAL_VOICE_FFMPEG=
